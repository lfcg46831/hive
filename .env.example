# Local Docker Compose defaults only. Copy this file to `.env` before starting
# HIVE. Never reuse these credentials outside a local development environment.
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=hive

# Required only by the real-provider demo overrides. Copy this file to `.env`
# and set the secret locally; never commit a populated `.env` file.
OPENAI_API_KEY=
# Optional. The demo overrides use gpt-5-mini when this remains unset.
OPENAI_MODEL_ID=

# Required only by the console override (docker-compose.console.yml). The same
# token is the credential the public API accepts and the one the console
# presents, and it is served to the browser, so use a local development value
# only. Compose refuses to start the override while it is empty.
HIVE_CONSOLE_ORGANIZATION_ID=acme-delivery
HIVE_CONSOLE_TOKEN=
# Optional. Interval of the console's /position-states polling fallback.
HIVE_CONSOLE_POLL_INTERVAL_MS=5000
